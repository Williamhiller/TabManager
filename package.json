    "@types/react-dom": "19.2.3",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.3.0",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.2",
    "wxt": "0.20.24"
