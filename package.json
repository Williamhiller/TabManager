    "check:auto-groups": "node scripts/check-auto-group-defaults.mjs",
    "check:extension-favicon": "node scripts/check-extension-favicon.mjs",
    "check:history-tabs": "node scripts/check-history-tabs-default-collapsed.mjs",
    "check:locale": "node scripts/check-locale-resolution.mjs",
    "check:tab-detail": "node scripts/check-tab-detail-modal.mjs",
    "check:temporary-auto-groups": "node scripts/check-temporary-auto-groups.mjs",
